rules_version = '2';

/*
 * Правила доступа к базе.
 *
 * Прежняя версия разрешала запись всем без исключения (`allow write: if true`).
 * Практически это значит, что любой человек, открывший сайт, мог из консоли браузера
 * переписать цены, подменить фотографии или стереть всё меню целиком — PIN-код панели
 * этому не мешает, потому что он проверяется в браузере, а не на сервере.
 *
 * Ниже запись разрешена только вошедшему пользователю Firebase Authentication.
 * Как завести такого пользователя и включить вход — см. docs/НАСТРОЙКА.md.
 *
 * ВНИМАНИЕ: пока владелец не настроил вход, панель сможет сохранять изменения только
 * локально (в браузере). Если нужно сначала развернуть сайт, а вход настроить позже,
 * временно замените `isOwner()` на `true` в блоках write — и обязательно верните обратно.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null;
    }

    // Меню видно всем — это витрина. Менять его может только владелец.
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Фотогалерея — то же самое.
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isOwner();
    }

    /*
     * Заказы. Создать заказ может любой посетитель, иначе форма не работала бы,
     * но читать и изменять чужие заказы нельзя: там имя и телефон покупателя.
     * Раньше `allow read: if true` открывал всю базу заказов любому желающему.
     */
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isOwner();
    }
  }
}
